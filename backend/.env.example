ANTHROPIC_API_KEY=your_api_key_here
# Obavezno, min 16 znakova. Ista vrednost ide u mobile/.env kao EXPO_PUBLIC_API_KEY.
# Generisi: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=generisi_dugacak_nasumican_kljuc

# --- Samo na serveru (Hetzner) ---
# DOCS=0 iskljucuje /docs (Swagger radi bez kljuca). Lokalno izostavi.
# DOCS=0
# CORS samo za web verziju; APK ga ne koristi. Prazno = iskljucen. Lokalno izostavi (= "*").
# CORS_ORIGINS=
# Najvise skupih zahteva na sat (0 = bez granice)
# LIMIT_AI_NA_SAT=150
# LIMIT_OBRADA_NA_SAT=30
