{
  "expo": {
    "name": "ReelFuel",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "reelfuel",
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "ReelFuel koristi kameru za skeniranje bar-koda sa pakovanja i slikanje obroka.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "ReelFuel upisuje tvoje treninge u poseban kalendar \"ReelFuel\"."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111311"
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "ReelFuel koristi mikrofon da ti zapiše šta si pojeo kad to izgovoriš.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111311",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "Reel.Fuel"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7bfd56a-a68b-47b2-9a4b-b3d44b81caca"
      }
    }
  }
}
